  button(380,245,140,28,"ADVANCED",0,0.85,0.55,0.15)?(
    adv_page=1;
  );
);

// Advanced menu.
adv_page?(
  gfx_set(0.07,0.10,0.18,0.97);rect(0,0,900,1150);
