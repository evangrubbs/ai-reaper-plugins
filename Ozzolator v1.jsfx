    knob(9,735,385,26,"G2 dB",-24,12,0.1,-4.5,0,0.28,0.40,0.52);
    knob(10,865,385,26,"Q2",0.5,100,0.01,7,1,0.28,0.40,0.52);

    knob(11,85,505,26,"F3 Hz",20,20000,1,1224,1,0.28,0.40,0.52);
