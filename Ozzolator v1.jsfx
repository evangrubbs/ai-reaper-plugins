    knob(62,150,210,28,"THRESHOLD",-80,0,0.1,-40,0,0.28,0.40,0.52);
    knob(63,350,210,28,"RANGE",-80,0,0.1,-20,0,0.60,0.39,0.22);
    knob(64,550,210,28,"RELEASE",10,2000,1,430,1,0.31,0.49,0.36);
    toggle(65,720,198,140,"F.ATK",slider65,1,0.75,0.22,0.20);

