  adv_page==3?(
    section("DOUBLER",120);
    knob(66,150,210,26,"FINE TRIM",-24,12,0.1,0,0,0.31,0.49,0.36);
    knob(73,350,210,26,"L DELAY",1,50,0.1,22,0,0.28,0.40,0.52);
    knob(74,550,210,26,"R DELAY",1,50,0.1,23,0,0.31,0.49,0.36);

    section("MULTI OUT ROUTING",330);
    rname(slider77);sprintf(#rb,"OUT 3/4: %s",#rn);
