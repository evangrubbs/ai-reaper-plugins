    text_at("Click a routing button to cycle its output pair between VOCAL, DOUBLER, and DELAY.",25,610);
    text_at("Use a 10-channel track in REAPER to access all output pairs.",25,660);
  );

  adv_page==4?(
    section("REVERB",120);
