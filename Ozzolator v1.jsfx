  gfx_setfont(1,"Arial",13);

  button(25,45,150,26,"EQ / CHANNEL",adv_page==1,0.20,0.45,0.75)?(adv_page=1;);
  button(185,45,250,26,"GATE / MULTIBAND / VOCAL",adv_page==2,0.55,0.30,0.70)?(adv_page=2;);
  button(445,45,110,26,"DOUBLER",adv_page==3,0.30,0.65,0.35)?(adv_page=3;);
  button(565,45,110,26,"REVERB",adv_page==4,0.62,0.27,0.24)?(adv_page=4;);
  button(685,45,80,26,"CLOSE",0,0.45,0.45,0.45)?(adv_page=0;);

  gfx_set(0.55,0.61,0.69,1);
  text_at("Drag knobs vertically. Double-click returns a knob to its default.",25,82);

  ui_gate=max(max(0,gatered),ui_gate*.82);
  ui_ch=max(max(0,-chan.gr),ui_ch*.82);
  ui_b1=max(max(0,-B1.gr),ui_b1*.82);
  ui_b2=max(max(0,-B2.gr),ui_b2*.82);
  ui_b3=max(max(0,-B3.gr),ui_b3*.82);
  ui_b4=max(max(0,-B4.gr),ui_b4*.82);
  ui_vo=max(max(0,-voice.gr),ui_vo*.82);
  ui_ex=max(max(0,-expander.gr),ui_ex*.82);
  ui_li=max(max(0,-20*log10(max(0.000000000001,lim_g))),ui_li*.82);

  slider3>.5?(
    ui_gate=0;ui_ch=0;ui_b1=0;ui_b2=0;ui_b3=0;ui_b4=0;ui_vo=0;ui_ex=0;ui_li=0;
  );

  adv_page==1?(
    section("INPUT",120);
    knob(1,150,210,26,"INPUT",-24,24,0.1,0,0,0.28,0.40,0.52);

    section("INPUT EQ",300);
    knob(4,85,385,26,"HP Hz",20,1000,1,160,1,0.28,0.40,0.52);
    knob(5,215,385,26,"F1 Hz",20,20000,1,200,1,0.28,0.40,0.52);
