desc:PV Decade (schematic model, BD# 99008050)
author:Claude
tags:guitar amp distortion
version:0.1

// ---------------------------------------------------------------------------
// Circuit-level model of the Peavey Decade built from the 6-18-80 schematic.
//
// Signal path modeled:
//   jack divider
//      -> U1B gain stage
//      -> diode-limited feedback
//      -> R40 + CR17/CR18 clamp
//      -> passive tone stack
//      -> U1A gain stage
//      -> MASTER divider
//      -> C19
//      -> CR7/CR8 input clamp
//      -> U2 power amp
//      -> rail limiting
//      -> C22 output coupling
//      -> speaker load
//
// Output is the speaker-terminal signal scaled so 10V peak = 1.0 FS.
//
// ASSUMPTIONS:
//   * Q1 (3919) and its network around U1B pin 6 are not modeled.
//   * U1B gain is approximated with the feedback network.
//   * Tone-stack topology is an approximation based on the schematic.
//   * U2 is approximated as a voltage amplifier with rail limiting.
// ---------------------------------------------------------------------------


slider1:0<0,1,1{Normal (-6dB),Saturated}>Input Jack
slider2:0<-24,24,0.1>Input Trim (dB)
slider3:5<0,10,0.1>Volume
slider4:5<0,10,0.1>Bass
slider5:5<0,10,0.1>Mid
slider6:5<0,10,0.1>Treble
slider7:5<0,10,0.1>Master
slider8:24<18,30,0.1>Supply Rail (V)
slider9:1<0,5,0.05>Supply Source Resistance (ohm, sag)
slider10:4<2,16,0.1>Load Impedance (ohm)
slider11:2<0,3,1{1x,2x,4x,8x}>Oversampling
slider12:0<-40,12,0.1>Output (dB)

in_pin:Input L
in_pin:Input R
out_pin:Output L
out_pin:Output R


@init

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

PI2 = 6.283185307179586;

Is = 0.00000000252;
nVt = 0.0453132;
invnvt = 1 / nVt;


// ---------------------------------------------------------------------------
// Memory map
//
// pA    = 8x16 augmented matrix
// pINV  = 8x8 inverse matrix
// pRHS  = 8-element RHS
// pXV   = 8-element node-voltage result
// ---------------------------------------------------------------------------

pA   = 0;
pINV = 128;
pRHS = 192;
pXV  = 200;


// ---------------------------------------------------------------------------
// Tone-stack capacitor state
// ---------------------------------------------------------------------------

pCA = 208;
pCB = 216;
pCG = 224;
pCH = 232;


// ---------------------------------------------------------------------------
// Oversampling filter coefficients and state
// ---------------------------------------------------------------------------

pUPC = 240;
pDNC = 256;
pUPS = 272;
pDNS = 280;
pHPS = 288;


// ---------------------------------------------------------------------------
// Tone-stack capacitor connections
//
// Node numbers:
//
// C14: node 0 -> node 1
// C13: node 2 -> node 3
// C11: node 2 -> node 5
// C12: node 5 -> ground
// C15: node 6 -> node 7
// ---------------------------------------------------------------------------

pCA[0] = 0;
pCB[0] = 1;

pCA[1] = 2;
pCB[1] = 3;

pCA[2] = 2;
pCB[2] = 5;

pCA[3] = 5;
pCB[3] = -1;

pCA[4] = 6;
pCB[4] = 7;


// ---------------------------------------------------------------------------
// Initialize states
// ---------------------------------------------------------------------------

memset(pCH,0,8);
memset(pHPS,0,16);
memset(pUPS,0,16);
memset(pDNS,0,16);

v0prev = 0;
vf1p = 0;
vf2p = 0;
vcp = 0;
env = 0;


// ---------------------------------------------------------------------------
// 2*sinh(x)
//
// Used for the anti-parallel diode model.
// ---------------------------------------------------------------------------

function sinh_part(s)
(
  s = max(min(s,40),-40);
  exp(s) - exp(-s);
);


// ---------------------------------------------------------------------------
// Stamp a resistor conductance into the matrix.
// ---------------------------------------------------------------------------

function stampG(a,b,g)
(
  a >= 0 ? pA[a*16+a] += g;
  b >= 0 ? pA[b*16+b] += g;

  (a >= 0 && b >= 0) ?
  (
    pA[a*16+b] -= g;
    pA[b*16+a] -= g;
  );
);


// ---------------------------------------------------------------------------
// Invert the 8x8 matrix.
//
// The matrix is stored as an augmented 8x16 matrix.
// ---------------------------------------------------------------------------

function ginv(n) local(i j k p piv t f)
(
  i = 0;

  loop(n,
    j = 0;

    loop(n,
      pA[i*16+8+j] = (i == j);
      j += 1;
    );

    i += 1;
  );


  k = 0;

  loop(n,

    p = k;
    piv = abs(pA[k*16+k]);

    i = k + 1;

    loop(n-k-1,

      t = abs(pA[i*16+k]);

      t > piv ?
      (
        piv = t;
        p = i;
      );

      i += 1;
    );


    p != k ?
    (
      j = 0;

      loop(2*n,

        t = pA[k*16+j];
        pA[k*16+j] = pA[p*16+j];
        pA[p*16+j] = t;

        j += 1;
      );
    );


    piv = pA[k*16+k];

    j = 0;

    loop(2*n,
      pA[k*16+j] /= piv;
      j += 1;
    );


    i = 0;

    loop(n,

      i != k ?
      (
        f = pA[i*16+k];

        j = 0;

        loop(2*n,
          pA[i*16+j] -= f * pA[k*16+j];
          j += 1;
        );
      );

      i += 1;
    );

    k += 1;
  );


  i = 0;

  loop(n,

    j = 0;

    loop(n,
      pINV[i*8+j] = pA[i*16+8+j];
      j += 1;
    );

    i += 1;
  );
);


// ---------------------------------------------------------------------------
// First-order high-pass filter.
//
// idx selects a pair of state variables.
// ---------------------------------------------------------------------------

function hp1(x,a,idx) local(y)
(
  y = a * (pHPS[idx+1] + x - pHPS[idx]);

  pHPS[idx] = x;
  pHPS[idx+1] = y;

  y;
);


// ---------------------------------------------------------------------------
// Op-amp feedback network.
//
// Resistor R in parallel with anti-parallel diode pair.
// Solved using Newton iteration.
// ---------------------------------------------------------------------------

function fbsolve(i,R,v) local(k s e f df dv)
(
  k = 0;

  loop(6,

    s = max(min(v*invnvt,40),-40);
    e = exp(s);

    f = v/R + Is*(e - 1/e) - i;

    df = 1/R + Is*(e + 1/e)*invnvt;

    dv = max(min(f/df,0.3),-0.3);

    v -= dv;

    k += 1;
  );

  v;
);


// ---------------------------------------------------------------------------
// Thevenin source feeding U2 input.
//
// Includes input resistance and anti-parallel diode clamp.
// ---------------------------------------------------------------------------

function clampsolve(Vh,Rs,Rin,v) local(k s e f df dv)
(
  k = 0;

  loop(6,

    s = max(min(v*invnvt,40),-40);
    e = exp(s);

    f = (v-Vh)/Rs + v/Rin + Is*(e - 1/e);

    df = 1/Rs + 1/Rin + Is*(e + 1/e)*invnvt;

    dv = max(min(f/df,0.3),-0.3);

    v -= dv;

    k += 1;
  );

  v;
);


// ---------------------------------------------------------------------------
// Three-section biquad cascade.
// ---------------------------------------------------------------------------

function bqrun(x,cb,sb) local(s y)
(
  s = 0;

  loop(3,

    y = cb[s*5]*x + sb[s*2];

    sb[s*2] =
      cb[s*5+1]*x
      - cb[s*5+3]*y
      + sb[s*2+1];

    sb[s*2+1] =
      cb[s*5+2]*x
      - cb[s*5+4]*y;

    x = y;

    s += 1;
  );

  x;
);


// ---------------------------------------------------------------------------
// Low-pass biquad section.
// ---------------------------------------------------------------------------

function lp_section(cb,s,fc,fs,Q) local(w cw al a0)
(
  w = PI2*fc/fs;
  cw = cos(w);
  al = sin(w)/(2*Q);
  a0 = 1 + al;

  cb[s*5] =
    (1-cw)*0.5/a0;

  cb[s*5+1] =
    (1-cw)/a0;

  cb[s*5+2] =
    (1-cw)*0.5/a0;

  cb[s*5+3] =
    -2*cw/a0;

  cb[s*5+4] =
    (1-al)/a0;
);


// ---------------------------------------------------------------------------
// MAIN PEAVEY DECADE SIGNAL PATH
// ---------------------------------------------------------------------------

function decade(vin) local(v ib Rf1 vs k j i ia_ ib_ h u0 Z s e f df dv id x vc g ia vts vu vth vh vpa L rail vo)
(

  // -------------------------------------------------------------------------
  // INPUT JACK + C1
  // -------------------------------------------------------------------------

  v = hp1(vin*jackg,a_in,0);


  // -------------------------------------------------------------------------
  // U1B GAIN STAGE
  // -------------------------------------------------------------------------

  ib = hp1(v,a_u1b,2)/2700;

  Rf1 = 680 + 10000*vol;

  vf1p = fbsolve(ib,Rf1,vf1p);

  vs = v + vf1p;


  // -------------------------------------------------------------------------
  // R40 + CR17/CR18 + TONE STACK
  // -------------------------------------------------------------------------

  memset(pRHS,0,8);

  pRHS[0] = vs*0.001;


  k = 0;

  loop(5,

    ia_ = pCA[k];
    ib_ = pCB[k];
    h = pCH[k];

    ia_ >= 0 ?
      pRHS[ia_] += h;

    ib_ >= 0 ?
      pRHS[ib_] -= h;

    k += 1;
  );


  // Calculate node 0 open-circuit voltage.

  u0 = 0;
  j = 0;

  loop(8,

    u0 += pINV[j]*pRHS[j];

    j += 1;
  );


  Z = pINV[0];


  // Solve nonlinear diode voltage.

  k = 0;

  loop(6,

    s = max(min(v0prev*invnvt,40),-40);
    e = exp(s);

    f =
      v0prev
      - u0
      + Z*Is*(e - 1/e);

    df =
      1
      + Z*Is*(e + 1/e)*invnvt;

    dv = max(min(f/df,0.3),-0.3);

    v0prev -= dv;

    k += 1;
  );


  id = Is*sinh_part(v0prev*invnvt);


  // Solve all tone-stack node voltages.

  i = 0;

  loop(8,

    x = 0;

    j = 0;

    loop(8,

      x += pINV[i*8+j]*pRHS[j];

      j += 1;
    );

    pXV[i] =
      x
      - pINV[i*8]*id;

    i += 1;
  );


  // Update capacitor history.

  k = 0;

  loop(5,

    ia_ = pCA[k];
    ib_ = pCB[k];

    vc =
      (ia_ >= 0 ? pXV[ia_] : 0)
      -
      (ib_ >= 0 ? pXV[ib_] : 0);

    g = pCG[k];

    pCH[k] =
      2*g*vc
      - pCH[k];

    k += 1;
  );


  vts = pXV[7];


  // -------------------------------------------------------------------------
  // U1A GAIN STAGE
  // -------------------------------------------------------------------------

  ia = hp1(vts,a_u1a,4)/10000;

  vf2p = fbsolve(ia,33000,vf2p);

  vu = vts + vf2p;


  // -------------------------------------------------------------------------
  // MASTER DIVIDER + C19 + CR7/CR8
  // -------------------------------------------------------------------------

  vth = vu*mdiv;

  vh = hp1(vth,a_m,6);

  vcp =
    clampsolve(
      vh,
      mRs,
      200000,
      vcp
    );


  // -------------------------------------------------------------------------
  // U2 POWER AMP
  // -------------------------------------------------------------------------

  vpa = 23*vcp;


  // Supply sag.

  rail =
    slider8
    - slider9*env/slider10*1.2;


  // Approximate available output swing.

  L = max((rail-5)*0.5,1);


  // Soft rail limiting.

  vpa =
    vpa /
    pow(
      1 + pow(abs(vpa)/L,4),
      0.25
    );


  // Envelope used for supply sag.

  env +=
    kenv *
    (abs(vpa)-env);


  // -------------------------------------------------------------------------
  // C22 OUTPUT COUPLING INTO LOAD
  // -------------------------------------------------------------------------

  vo = hp1(vpa,a_out,8);

  vo;
);


// ===========================================================================
// SLIDER UPDATE
// ===========================================================================

@slider


// ---------------------------------------------------------------------------
// Input jack
// ---------------------------------------------------------------------------

jackg =
  slider1 ?
  1000/(1000+47)
  :
  0.5;


// ---------------------------------------------------------------------------
// Input trim
// ---------------------------------------------------------------------------

trimg =
  pow(10,slider2/20);


// ---------------------------------------------------------------------------
// Front-panel controls
// ---------------------------------------------------------------------------

vol  = slider3*0.1;
bass = slider4*0.1;
mid  = slider5*0.1;
treb = slider6*0.1;
mst  = slider7*0.1;


// ---------------------------------------------------------------------------
// Oversampling
// ---------------------------------------------------------------------------

OS =
  floor(
    pow(2,slider11)+0.5
  );

fs = srate*OS;

T = 1/fs;


// ---------------------------------------------------------------------------
// Output gain
// ---------------------------------------------------------------------------

outg =
  pow(10,slider12/20)*0.1;


// ---------------------------------------------------------------------------
// Supply sag envelope coefficient
// ---------------------------------------------------------------------------

kenv =
  1-exp(-T/0.05);


// ===========================================================================
// TONE STACK MATRIX
// ===========================================================================

memset(pA,0,128);


// R40

stampG(
  0,
  -1,
  1/1000
);


// R14

stampG(
  0,
  2,
  1/47000
);


// R18 upper section

stampG(
  1,
  6,
  1/(250000*(1-treb)+100)
);


// R18 lower section

stampG(
  6,
  3,
  1/(250000*treb+100)
);


// R17

stampG(
  3,
  4,
  1/10000
);


// R16 bass

stampG(
  4,
  -1,
  1/(250000*pow(bass,3)+100)
);


// R15 mid

stampG(
  5,
  -1,
  1/(50000*mid+100)
);


// R19

stampG(
  7,
  -1,
  1/470000
);


// ---------------------------------------------------------------------------
// Capacitor companion conductances.
//
// Original values:
//
// C14 = 270 pF
// C13 = 33 nF
// C11 = 100 nF
// C12 = 15 nF
// C15 = 100 nF
//
// Values are written as ordinary decimal numbers for EEL2 compatibility.
// ---------------------------------------------------------------------------

pCG[0] =
  2*0.000000000270/T;

pCG[1] =
  2*0.000000033/T;

pCG[2] =
  2*0.0000001/T;

pCG[3] =
  2*0.000000015/T;

pCG[4] =
  2*0.0000001/T;


// Stamp capacitor conductances.

k = 0;

loop(5,

  stampG(
    pCA[k],
    pCB[k],
    pCG[k]
  );

  k += 1;
);


// Invert tone-stack matrix.

ginv(8);


// ===========================================================================
// HIGH-PASS CORNERS
// ===========================================================================


// C1 / input resistance

a_in =
  1 /
  (
    1
    + PI2*7*T
  );


// C10 / R13

a_u1b =
  1 /
  (
    1
    + PI2*
      (
        1 /
        (
          PI2*2700*0.0000022
        )
      )
      *T
  );


// C16 / R20

a_u1a =
  1 /
  (
    1
    + PI2*
      (
        1 /
        (
          PI2*10000*0.0000022
        )
      )
      *T
  );


// C22 / speaker load

a_out =
  1 /
  (
    1
    + PI2*
      (
        1 /
        (
          PI2*slider10*0.001
        )
      )
      *T
  );


// ===========================================================================
// MASTER THEVENIN EQUIVALENT
// ===========================================================================

mRb =
  mst*10000;

mRt =
  22000
  + (1-mst)*10000;

mdiv =
  mRb/(mRb+mRt);

mRs =
  max(
    mRb*mRt/(mRb+mRt),
    100
  );

a_m =
  1 /
  (
    1
    + PI2*
      (
        1 /
        (
          PI2*(mRs+200000)*0.000000015
        )
      )
      *T
  );


// ===========================================================================
// OVERSAMPLING FILTERS
// ===========================================================================

fcos =
  min(
    0.45*srate,
    20000
  );


// Upsampling filter.

lp_section(
  pUPC,
  0,
  fcos,
  fs,
  0.5176
);

lp_section(
  pUPC,
  1,
  fcos,
  fs,
  0.7071
);

lp_section(
  pUPC,
  2,
  fcos,
  fs,
  1.9319
);


// Downsampling filter.

lp_section(
  pDNC,
  0,
  fcos,
  fs,
  0.5176
);

lp_section(
  pDNC,
  1,
  fcos,
  fs,
  0.7071
);

lp_section(
  pDNC,
  2,
  fcos,
  fs,
  1.9319
);


// ===========================================================================
// AUDIO SAMPLE PROCESSING
// ===========================================================================

@sample


// Mono input.

x =
  (spl0+spl1)
  *0.5
  *trimg;


// ---------------------------------------------------------------------------
// Oversampled path
// ---------------------------------------------------------------------------

OS > 1 ?
(
  j = 0;

  loop(OS,

    // Zero-stuffing.

    u =
      (j == 0 ?
        x*OS
        :
        0);


    // Upsampling low-pass.

    u =
      bqrun(
        u,
        pUPC,
        pUPS
      );


    // Nonlinear amplifier model.

    y =
      decade(u);


    // Downsampling low-pass.

    y =
      bqrun(
        y,
        pDNC,
        pDNS
      );


    // Retain first sample.

    j == 0 ?
    (
      out = y;
    );

    j += 1;
  );
)


// ---------------------------------------------------------------------------
// Normal-rate path
// ---------------------------------------------------------------------------

:
(
  out =
    decade(x);
);


// ---------------------------------------------------------------------------
// Output
// ---------------------------------------------------------------------------

spl0 =
  spl1 =
  out*outg;
